# CloudBase environment shared with the mini program.
CLOUDBASE_ENV_ID=maytoday-tcb-d7gf65eef0aeea220
# Tencent Cloud API key allowed to invoke the `auth` and `preset` cloud functions.
# Server-only: never expose these to the browser.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# Which mini program build the login code opens: release | trial | develop.
WXACODE_ENV_VERSION=release
# Set to 1 to run against the in-memory mock instead of CloudBase.
CLOUDBASE_MOCK=
